# Copie para .env somente no ambiente local. Nunca versione segredos reais.
DATABASE_URL=postgresql://aprendevest:aprendevest@localhost:5432/aprendevest
# Use uma conexão direta, sem pooler, para migrações em bancos gerenciados.
DATABASE_URL_UNPOOLED=
APP_URL=http://localhost:3000
APP_VERSION=0.1.0
SEED_EDITOR_PASSWORD=
SEED_REVIEWER_PASSWORD=
FEATURE_ESSAYS=true
FEATURE_AI_TUTOR=false
FEATURE_TEACHERS=false
FEATURE_BILLING=false
